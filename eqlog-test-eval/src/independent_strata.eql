type El;

pred seed(El);
pred edge(El, El);
pred left(El);
pred right(El);
pred right_next(El);
pred joined(El);
pred reach_left(El);
pred reach_right(El);
pred return_right(El);
pred reached(El);
pred result(El);
pred backwards(El);
pred tag(El);
pred marked(El);
pred mark_done(El);
pred alternate(El);
pred out(El);
pred out_done(El);

rule make_left { if seed(x); then left(x); }
rule make_right { if seed(x); then right(x); }
rule next_right { if right(x); then right_next(x); }
rule join { if left(x); if right_next(x); then joined(x); }

rule seed_left { if seed(x); then reach_left(x); }
rule seed_right { if seed(x); then reach_right(x); }
rule walk_left { if reach_left(x); if edge(x, y); then reach_left(y); }
rule right_out { if reach_right(x); then return_right(x); }
rule right_back { if return_right(x); if edge(x, y); then reach_right(y); }
rule summarize { if reach_left(x); if reach_right(x); then reached(x); }
rule output { if seed(x); if joined(x); if reached(x); then result(x); }
rule reverse { if backwards(y); if edge(x, y); then backwards(x); }

rule mark { if tag(x); then marked(x); }
rule finish_mark { if marked(x); then mark_done(x); }
rule emit_seed { if seed(x); then out(x); }
rule emit_alternate { if alternate(x); then out(x); }
rule finish_out { if out(x); then out_done(x); }

model StableBox {
    pred link(El, El);
    pred local_reach(El);
    model Detail { pred detail_link(El, El); }
    pred descended(Detail, El);
    pred detail_query(Detail, El);
    pred detail_result(Detail, El);
    rule descend {
        if descended(d, y);
        if d.detail_link(x, y);
        then descended(d, x);
    }
    rule follow_detail_link {
        if descended(d, x);
        if d.detail_link(x, y);
        then descended(d, y);
    }
    rule inspect_detail {
        if detail_query(d, x);
        if d.detail_link(x, y);
        if d.detail_link(z, y);
        then detail_result(d, z);
    }
}
pred global_reach(StableBox, El);
pred echo(StableBox, El);
rule global_step {
    if global_reach(b, y);
    if b.link(x, y);
    then global_reach(b, x);
}
rule mixed_step {
    if b: StableBox;
    if b.local_reach(y);
    if b.link(x, y);
    then b.local_reach(x);
    then echo(b, x);
}
