model Set {
    type S;

    pred is_subterminal();
    pred flagged(S);
    // Regression fixture: visible Set args should copy across morphisms,
    // while only the hidden parent Set column is rewritten from dom to cod.
    pred tagged_by(Set, S);

    rule reflexivity_member {
        if x: S;
        then x = x;
    }

    rule is_subterminal_member_collapse {
        if is_subterminal();
        if x: S;
        if y: S;
        then x = y;
    }
}

rule reflexivity_global {
    if set: Set;
    if x: set.S;
    then x = x;
}

pred is_subterminal_set(set: Set);
rule is_subterminal_set_collapse {
    if set_0: Set;
    if set_1: Set;
    if x: set_0.S;
    if y: set_0.S;
    if is_subterminal_set(set_0);
    if set_0 = set_1;
    then x = y;
}

pred reached_flagged_image(set: Set);
rule lookup_flagged_image_by_member {
    if f: Mor(Set);
    if set_0 = dom(f);
    if x: set_0.S;
    if set.flagged(f@(x));
    then reached_flagged_image(set);
}
