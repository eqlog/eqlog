type El;
pred edge(El, El);
pred start(El);
pred end(El);
pred forward(El);
pred backward(El);
pred diagonal(El);
pred has_outgoing(El);
pred scan();
pred scanned(El, El);
pred joined(El, El);

rule forward_step {
    if start(x);
    if edge(x, y);
    then forward(y);
}

rule backward_step {
    if end(y);
    if edge(x, y);
    then backward(x);
}

rule diagonal_step {
    if start(x);
    if edge(x, x);
    then diagonal(x);
}

rule private_outgoing {
    if start(x);
    if edge(x, _);
    then has_outgoing(x);
}

rule scan_edges {
    if edge(x, y);
    if scan();
    then scanned(x, y);
}

rule join_edges {
    if start(x);
    if edge(x, y);
    if edge(y, z);
    then joined(x, z);
}
