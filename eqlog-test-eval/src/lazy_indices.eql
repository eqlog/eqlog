type El;
pred edge(El, El);
pred start(El);
pred end(El);
pred forward(El);
pred backward(El);
pred diagonal(El);
pred has_outgoing(El);
pred scan();
pred scanned(El, El);
pred joined(El, El);

rule forward_step {
    if start(x);
    if edge(x, y);
    then forward(y);
}

rule backward_step {
    if end(y);
    if edge(x, y);
    then backward(x);
}

rule diagonal_step {
    if start(x);
    if edge(x, x);
    then diagonal(x);
}

rule private_outgoing {
    if start(x);
    if edge(x, _);
    then has_outgoing(x);
}

rule scan_edges {
    if edge(x, y);
    if scan();
    then scanned(x, y);
}

rule join_edges {
    if start(x);
    if edge(x, y);
    if edge(y, z);
    then joined(x, z);
}

model Joins {
    pred query(El, El);
    func action(El, El) -> El;
    func product(El, El) -> El;
    func unindexed_product(El, El) -> El;
    pred resolved(El, El, El);
    pred fallback_resolved(El, El, El);
    pred inspect_product(El);
    pred factors(El, El);

    rule resolve {
        if query(c, x);
        if y = action(f, x);
        if c = product(f, g);
        then resolved(g, x, y);
    }
    rule fallback_resolve {
        if query(c, x);
        if y = action(f, x);
        if c = unindexed_product(f, g);
        then fallback_resolved(g, x, y);
    }
    rule factor_index {
        if inspect_product(c);
        if c = product(f, g);
        then factors(f, g);
    }
}
