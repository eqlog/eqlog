// Coverage for morphism application whose morphism is an ambient const,
// a function application, or a member const.

model Set {
    type S;
}

const c: Mor(Set);

rule const_mor_total {
    if s = dom(c);
    if x: s.S;
    if cod(c)!;
    then c.S(x)!;
}

func pick(s: Set) -> Mor(Set);

rule picked_mor_total {
    if f = pick(s);
    if t = dom(f);
    if x: t.S;
    if cod(f)!;
    then pick(s).S(x)!;
}

pred reached(s: Set);

rule mor_app_pattern {
    if f = pick(s);
    if t = dom(f);
    if x: t.S;
    if cod(f)!;
    if y = f.S(x);
    match y {
        f.S(x) => {
            then reached(s);
        }
    }
}

model Bundle {
    type Elem;
    const mor: Mor(Bundle);
}

rule bundle_mor_total {
    if b: Bundle;
    if s = dom(b.mor);
    if x: s.Elem;
    if cod(b.mor)!;
    then b.mor.Elem(x)!;
}
