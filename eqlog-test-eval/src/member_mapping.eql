type Label;

model World {
    type El;
    pred edge(El, El);
    pred tagged(El, Label);
    pred labelled_edge(El, Label, El);
    pred matched_labelled_edge(El, Label, El);
    pred reached(El);
    rule step {
        if reached(x);
        if edge(x, y);
        then reached(y);
    }
}

pred request(World);
pred observed(World, Label);
rule observe {
    if request(w);
    if w.reached(x);
    if w.tagged(x, label);
    then observed(w, label);
}

pred request_label(World, Label);
rule match_labelled_edge {
    if request_label(w, label);
    if w.labelled_edge(x, label, y);
    then w.matched_labelled_edge(x, label, y);
}
