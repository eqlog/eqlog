type El;
pred le(El, El);
func meet(El, El) -> El;

// Axioms of posets.
rule {
    if x: El;
    then le(x, x);
}
rule {
    if le(x, y);
    if le(y, z);
    then le(x, z);
}
rule {
    if le(x, y);
    if le(y, x);
    then x = y;
}

// Axioms of meets.
rule {
    if x: El;
    if y: El;
    then meet(x, y)!;
}
rule {
    if m = meet(x, y);
    then le(m, x);
    then le(m, y);
}
rule {
    if le(z, x);
    if le(z, y);
    if m = meet(x, y);
    then le(z, m);
}
