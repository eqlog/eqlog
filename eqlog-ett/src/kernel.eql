type Data;
type Constructor;

model Context {
    type Ty;
    type Tm;
    type Args;
    pred has_type(Tm, Ty);
    func nil_args() -> Args;
    func cons_args(Tm, Args) -> Args;
    func cons_type_args(Ty, Args) -> Args;
    func last_arg(Args) -> Tm;
    func data_type(Data, Args) -> Ty;
    func construct(Constructor, Args) -> Tm;
    func equality(Tm, Tm) -> Ty;
    func refl(Tm) -> Tm;

    rule last_singleton {
        if xs = cons_args(x, nil_args());
        then last_arg(xs) = x;
    }
    rule last_cons {
        if xs = cons_args(x, rest);
        if y = last_arg(rest);
        then last_arg(xs) = y;
        then x = x;
    }
    rule last_type_cons {
        if xs = cons_type_args(a, rest);
        if y = last_arg(rest);
        then last_arg(xs) = y;
        then a = a;
    }
    rule refl_typing {
        if r = refl(x);
        if has_type(x, t);
        then a := equality(x, x)!;
        then has_type(r, a);
        then t = t;
    }
    rule equality_reflection {
        if a = equality(x, y);
        if has_type(r, a);
        then x = y;
        then r = r;
    }
    rule equality_uniqueness {
        if a = equality(x, y);
        if has_type(r, a);
        if has_type(s, a);
        then r = s;
        then x = x;
        then y = y;
    }
}

func empty() -> Context;
pred extension(e: Context, g: Context, a: g.Ty, p: Mor(Context));
pred type_extension(e: Context, g: Context, p: Mor(Context));
// Fresh statement scopes keep reflected equalities from flowing into earlier statements.
pred advance(g: Context, e: Context, p: Mor(Context));
func variable(g: Context) -> g.Tm;
func type_variable(g: Context) -> g.Ty;
// Restricting only requested composites keeps the allocation diagram finite.
func compose(Mor(Context), Mor(Context)) -> Mor(Context);
// Both kinds of variable extension and statement scopes share this ancestry.
pred context_parent(Context, Context, Mor(Context));
pred closed_context(Context);
pred variable_context(Context);
// A scope without local variables has at most one substitution to a given target.
func closed_substitution(Context, Context) -> Mor(Context);
// Argument typing is a Rust obligation in the context before this substitution.
func pair(e: Context, d: Context, f: Mor(Context), t: d.Tm) -> Mor(Context);
func pair_type(e: Context, d: Context, f: Mor(Context), a: d.Ty) -> Mor(Context);

rule empty_context {
    if g = empty();
    then closed_context(g);
}
rule comprehension {
    if extension(e, g, a, p);
    then dom(p) = g;
    then cod(p) = e;
    then context_parent(e, g, p);
    then variable_context(e);
    then b := p.Ty(a)!;
    then q := variable(e)!;
    then e.has_type(q, b);
}
rule type_comprehension {
    if type_extension(e, g, p);
    then dom(p) = g;
    then cod(p) = e;
    then context_parent(e, g, p);
    then variable_context(e);
    then type_variable(e)!;
}
rule statement_context {
    if advance(g, e, p);
    then dom(p) = g;
    then cod(p) = e;
    then context_parent(e, g, p);
}
rule closed_statement {
    if advance(g, e, p);
    if closed_context(g);
    then closed_context(e);
    then p = p;
}
rule variable_statement {
    if advance(g, e, p);
    if variable_context(g);
    then variable_context(e);
    then p = p;
}
rule composition {
    if h = compose(f, g);
    if cod(f) = dom(g);
    then h = f >> g;
}
// Restriction descends the finite source-context ancestry, without allocating terms.
rule composition_restriction {
    if h = compose(f, g);
    if e = dom(h);
    if variable_context(e);
    if context_parent(e, parent, p);
    then compose(p, h)!;
    then f = f;
    then g = g;
    then parent = parent;
}
rule pairing {
    if h = pair(e, d, f, t);
    if extension(e, g, a, p);
    if dom(f) = g;
    if cod(f) = d;
    if b = f.Ty(a);
    if q = variable(e);
    then d.has_type(t, b);
    then dom(h) = e;
    then cod(h) = d;
    then h.Tm(q) = t;
    then p >> h = f;
}
rule pairing_eta {
    if extension(e, g, a, p);
    if dom(h) = e;
    if d = cod(h);
    if q = variable(e);
    if t = h.Tm(q);
    if f = p >> h;
    then pair(e, d, f, t) = h;
    then g = g;
    then a = a;
}

rule type_pairing {
    if h = pair_type(e, d, f, a);
    if type_extension(e, g, p);
    if dom(f) = g;
    if cod(f) = d;
    if q = type_variable(e);
    then dom(h) = e;
    then cod(h) = d;
    then h.Ty(q) = a;
    then p >> h = f;
}
rule type_pairing_eta {
    if type_extension(e, g, p);
    if dom(h) = e;
    if d = cod(h);
    if q = type_variable(e);
    if a = h.Ty(q);
    if f = p >> h;
    then pair_type(e, d, f, a) = h;
    then g = g;
}

// An rfl obligation observes this request before any continuation assumes its type.
pred reflexivity_goal(g: Context, a: g.Ty, r: g.Tm);
rule check_reflexivity {
    if reflexivity_goal(g, a, r);
    if a = g.equality(x, x);
    then r = g.refl(x);
}

// Images remain partial: requesting a result does not copy its hidden subterms.
pred type_image(f: Mor(Context), g: Context, a: g.Ty, d: Context, b: d.Ty);
pred term_image(f: Mor(Context), g: Context, t: g.Tm, d: Context, u: d.Tm);
rule requested_type_image {
    if type_image(f, g, a, d, b);
    if dom(f) = g;
    if cod(f) = d;
    then f.Ty(a) = b;
}
rule requested_term_image {
    if term_image(f, g, t, d, u);
    if dom(f) = g;
    if cod(f) = d;
    then f.Tm(t) = u;
}

func instance(source: Context, body: source.Tm, target: Context, args: target.Args) -> target.Tm;
rule image_instance {
    if f: Mor(Context);
    if s = dom(f);
    if t = cod(f);
    if a = instance(source, body, s, args);
    if images = f.Args(args);
    if b = instance(source, body, t, images);
    then f.Tm(a) = b;
}
rule open_instance {
    if f: Mor(Context);
    if s = dom(f);
    if t = cod(f);
    if a = instance(source, body, s, args);
    if b = f.Tm(a);
    if images = f.Args(args);
    then instance(source, body, t, images) = b;
}

type Telescope;
func telescope_end(Context) -> Telescope;
func telescope_cons(Context, Telescope) -> Telescope;
func instantiate(t: Telescope, d: Context, f: Mor(Context), xs: d.Args) -> Mor(Context);
rule instantiate_end {
    if h = instantiate(telescope_end(e), d, f, d.nil_args());
    if g = dom(f);
    then h = through(g, e, d, f);
}
rule instantiate_cons {
    if h = instantiate(telescope_cons(e, rest), d, f, xs);
    if xs = d.cons_args(x, tail);
    if extension(e, g, a, projection);
    if source = dom(f);
    if cod(f) = d;
    then k := through(source, g, d, f)!;
    then dom(k) = g;
    then cod(k) = d;
    then projection = projection;
    then k.Ty(a)!;
    then p := pair(e, d, k, x)!;
    then h = instantiate(rest, d, p, tail);
}

rule instantiate_type_cons {
    if h = instantiate(telescope_cons(e, rest), d, f, xs);
    if xs = d.cons_type_args(a, tail);
    if type_extension(e, g, projection);
    if source = dom(f);
    if cod(f) = d;
    then k := through(source, g, d, f)!;
    then p := pair_type(e, d, k, a)!;
    then h = instantiate(rest, d, p, tail);
    then projection = projection;
}

type Eliminator;
pred elimination(e: Eliminator, d: Data, g: Context, a: g.Ty, t: g.Tm);
func elimination_base(Eliminator) -> Context;
func elimination_telescope(Eliminator) -> Telescope;
func elimination_template(Eliminator) -> Context;
rule elimination_typing {
    if elimination(e, d, g, a, t);
    then g.has_type(t, a);
    then e = e;
    then d = d;
}

rule image_nil {
    if f: Mor(Context);
    if s = dom(f);
    if t = cod(f);
    if a = s.nil_args();
    then b := t.nil_args()!;
    then f.Args(a) = b;
}
rule image_cons {
    if f: Mor(Context);
    if s = dom(f);
    if t = cod(f);
    if a = s.cons_args(x, xs);
    if y = f.Tm(x);
    if ys = f.Args(xs);
    then b := t.cons_args(y, ys)!;
    then f.Args(a) = b;
}
rule image_type_cons {
    if f: Mor(Context);
    if s = dom(f);
    if t = cod(f);
    if a = s.cons_type_args(x, xs);
    if y = f.Ty(x);
    if ys = f.Args(xs);
    then b := t.cons_type_args(y, ys)!;
    then f.Args(a) = b;
}
rule image_data_type {
    if f: Mor(Context);
    if s = dom(f);
    if t = cod(f);
    if a = s.data_type(d, xs);
    if ys = f.Args(xs);
    if b = t.data_type(d, ys);
    then f.Ty(a) = b;
}
rule image_constructor {
    if f: Mor(Context);
    if s = dom(f);
    if t = cod(f);
    if a = s.construct(c, xs);
    if ys = f.Args(xs);
    if b = t.construct(c, ys);
    then f.Tm(a) = b;
}
rule image_equality {
    if f: Mor(Context);
    if s = dom(f);
    if t = cod(f);
    if a = s.equality(x, y);
    if x_1 = f.Tm(x);
    if y_1 = f.Tm(y);
    if b = t.equality(x_1, y_1);
    then f.Ty(a) = b;
}
rule image_refl {
    if f: Mor(Context);
    if s = dom(f);
    if t = cod(f);
    if a = s.refl(x);
    if y = f.Tm(x);
    if b = t.refl(y);
    then f.Tm(a) = b;
}

func application(e: Eliminator, f: Mor(Context), g: Context, xs: g.Args) -> g.Tm;
pred applied(e: Eliminator, f: Mor(Context), g: Context, xs: g.Args);
rule application_instance {
    if application(e, f, g, xs)!;
    if b = elimination_base(e);
    if telescope = elimination_telescope(e);
    if dom(f) = b;
    if cod(f) = g;
    then instantiate(telescope, g, f, xs)!;
}
rule application_image {
    if result = application(e, f, g, xs);
    if elimination(e, d, m, a, r);
    if telescope = elimination_telescope(e);
    if template = elimination_template(e);
    if p = instantiate(telescope, g, f, xs);
    if dom(p) = template;
    if cod(p) = g;
    then h := rebase(m, g, p)!;
    then dom(h) = m;
    then cod(h) = g;
    then h.Ty(a)!;
    then h.Tm(r) = result;
    then applied(e, f, g, xs);
    then d = d;
}
rule image_application {
    if f: Mor(Context);
    if s = dom(f);
    if t = cod(f);
    if a = application(e, g, s, xs);
    if ys = f.Args(xs);
    if h = compose(g, f);
    if b = application(e, h, t, ys);
    then f.Tm(a) = b;
}
rule open_application {
    if f: Mor(Context);
    if s = dom(f);
    if t = cod(f);
    if a = application(e, g, s, xs);
    if b = f.Tm(a);
    if ys = f.Args(xs);
    if h = compose(g, f);
    then application(e, h, t, ys) = b;
}

func rebase(e: Context, d: Context, f: Mor(Context)) -> Mor(Context);
rule rebase_statement {
    if h = rebase(e, d, f);
    if advance(g, e, p);
    if dom(f) = g;
    if cod(f) = d;
    then dom(h) = e;
    then cod(h) = d;
    then p >> h = f;
}
rule rebase_eta {
    if advance(g, e, p);
    if dom(h) = e;
    if d = cod(h);
    if f = p >> h;
    then rebase(e, d, f) = h;
    then g = g;
}
rule closed_substitution_uniqueness {
    if closed_context(g);
    if dom(f) = g;
    if d = cod(f);
    then closed_substitution(g, d) = f;
}

type Expansion;
func next_expansion(Expansion) -> Expansion;
pred expand(site: Expansion, e: Eliminator, f: Mor(Context), g: Context, x: g.Args);
type Call;
func direct_call(e: Eliminator, f: Mor(Context), g: Context, xs: g.Args) -> Call;
func image_call(Call, Mor(Context)) -> Call;
pred call_shape(c: Call, e: Eliminator, f: Mor(Context), g: Context, xs: g.Args);
pred literal(Expansion, Call);
rule direct_call_shape {
    if c = direct_call(e, f, g, xs);
    then call_shape(c, e, f, g, xs);
}
rule image_call_base {
    if image_call(c, h)!;
    if call_shape(c, e, f, g, xs);
    if dom(h) = g;
    then compose(f, h)!;
    then e = e;
    then xs = xs;
}
rule image_call_shape {
    if d = image_call(c, h);
    if call_shape(c, e, f, g, xs);
    if dom(h) = g;
    if target = cod(h);
    if ys = h.Args(xs);
    if base = compose(f, h);
    then call_shape(d, e, base, target, ys);
}
rule literal_application {
    if literal(site, c);
    if call_shape(c, e, f, g, x);
    then expand(site, e, f, g, x);
}
func through(start: Context, end: Context, target: Context, f: Mor(Context)) -> Mor(Context);
pred stage_step(Context, Context, Context);
rule through_identity {
    if h = through(g, g, d, f);
    if dom(f) = g;
    if cod(f) = d;
    then h = f;
}
rule through_statement {
    if h = through(start, end, d, f);
    if stage_step(start, end, previous);
    then k := through(start, previous, d, f)!;
    then h = rebase(end, d, k);
}
type BranchSteps;
func case_steps(Eliminator, Constructor) -> BranchSteps;
pred parameter_step(s: BranchSteps, g: Context, parameter: g.Tm, rest: BranchSteps);
pred type_parameter_step(s: BranchSteps, g: Context, parameter: g.Ty, rest: BranchSteps);
pred scope_step(BranchSteps, Context, Context, BranchSteps);
pred field_step(BranchSteps, Context, BranchSteps);
pred hypothesis_step(s: BranchSteps, g: Context, args: g.Args, e: Context, instance: Mor(Context), rest: BranchSteps);
pred finish_step(s: BranchSteps, g: Context, args: g.Args, end: Context, body: end.Tm);
pred body_base(BranchSteps, Mor(Context));
pred body_call(BranchSteps, Call);
func run_branch(s: BranchSteps, e: Eliminator, base: Mor(Context), f: Mor(Context), g: Context, xs: g.Args, fuel: Expansion, actual: g.Args) -> Mor(Context);

rule beta_request {
    if expand(site, e, f, g, xs);
    if next = next_expansion(site);
    if applied(e, f, g, xs);
    if x = g.last_arg(xs);
    if x = g.construct(c, fields);
    if steps = case_steps(e, c);
    then run_branch(steps, e, f, f, g, fields, next, xs)!;
}
rule branch_parameter {
    if h = run_branch(s, e, base, f, g, xs, fuel, actual);
    if parameter_step(s, source, parameter, rest);
    if dom(f) = source;
    if cod(f) = g;
    if xs = g.cons_args(x, tail);
    if x = f.Tm(parameter);
    then h = run_branch(rest, e, base, f, g, tail, fuel, actual);
}
rule branch_scope {
    if h = run_branch(s, e, base, f, g, xs, fuel, actual);
    if scope_step(s, start, end, rest);
    if dom(f) = start;
    if cod(f) = g;
    then k := through(start, end, g, f)!;
    then h = run_branch(rest, e, base, k, g, xs, fuel, actual);
}
rule branch_type_parameter {
    if h = run_branch(s, e, base, f, g, xs, fuel, actual);
    if type_parameter_step(s, source, parameter, rest);
    if dom(f) = source;
    if cod(f) = g;
    if xs = g.cons_type_args(a, tail);
    if a = f.Ty(parameter);
    then h = run_branch(rest, e, base, f, g, tail, fuel, actual);
}
rule branch_field {
    if h = run_branch(s, e, base, f, g, xs, fuel, actual);
    if field_step(s, target, rest);
    if extension(target, source, a, projection);
    if dom(f) = source;
    if cod(f) = g;
    if xs = g.cons_args(x, tail);
    then projection = projection;
    then f.Ty(a)!;
    then p := pair(target, g, f, x)!;
    then h = run_branch(rest, e, base, p, g, tail, fuel, actual);
}
rule branch_hypothesis {
    if h = run_branch(s, e, base, f, g, xs, fuel, actual);
    if hypothesis_step(s, source, args, target, instance, rest);
    if extension(target, source, a, projection);
    if dom(f) = source;
    if cod(f) = g;
    if recursive_args = f.Args(args);
    then projection = projection;
    then f.Ty(a)!;
    then compose(instance, f)!;
    then ih := application(e, base, g, recursive_args)!;
    then expand(fuel, e, base, g, recursive_args);
    then p := pair(target, g, f, ih)!;
    then h = run_branch(rest, e, base, p, g, xs, fuel, actual);
}
rule branch_finish {
    if h = run_branch(s, e, base, f, g, g.nil_args(), fuel, actual);
    if finish_step(s, source, expected, end, body);
    if dom(f) = source;
    if cod(f) = g;
    if actual = f.Args(expected);
    then h = through(source, end, g, f);
    then body = body;
    then fuel = fuel;
    then e = e;
    then base = base;
}
rule branch_body {
    if h = run_branch(s, e, base, f, g, g.nil_args(), fuel, actual);
    if finish_step(s, source, expected, end, body);
    if dom(h) = end;
    if cod(h) = g;
    if result = application(e, base, g, actual);
    then rhs := h.Tm(body)!;
    then result = rhs;
    then source = source;
    then expected = expected;
    then fuel = fuel;
    then f = f;
}
rule branch_body_application {
    if h = run_branch(s, e, base, f, g, xs, fuel, actual);
    if body_base(s, b);
    then compose(b, h)!;
    then e = e;
    then base = base;
    then f = f;
    then g = g;
    then xs = xs;
    then fuel = fuel;
    then actual = actual;
}
rule branch_body_expansion {
    if h = run_branch(s, e, base, f, g, xs, fuel, actual);
    if body_call(s, c);
    if call_shape(c, nested, b, source, args);
    if dom(h) = source;
    if cod(h) = g;
    if images = h.Args(args);
    if target_base = compose(b, h);
    then expand(fuel, nested, target_base, g, images);
    then e = e;
    then base = base;
    then f = f;
    then xs = xs;
    then actual = actual;
}
