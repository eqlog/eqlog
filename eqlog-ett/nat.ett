inductive Nat where
| zero
| succ (pred : Nat)

def add (m n : Nat) : Nat :=
  rec n motive (k : Nat) => Nat with
  | zero => m
  | succ k ih => Nat.succ ih
  end

theorem add_zero (n : Nat) : add n Nat.zero = n := rfl

theorem add_succ (m n : Nat) :
    add m (Nat.succ n) = Nat.succ (add m n) := rfl

theorem zero_add (n : Nat) : add Nat.zero n = n :=
  rec n motive (k : Nat) => add Nat.zero k = k with
  | zero => rfl
  | succ k ih => rfl
  end

theorem succ_add (m n : Nat) :
    add (Nat.succ m) n = Nat.succ (add m n) :=
  rec n motive (k : Nat) => add (Nat.succ m) k = Nat.succ (add m k) with
  | zero => rfl
  | succ k ih => rfl
  end

theorem add_comm (m n : Nat) : add m n = add n m :=
  rec n motive (k : Nat) => add m k = add k m with
  | zero => zero_add m
  | succ k ih => succ_add k m
  end

theorem add_assoc (a b c : Nat) : add (add a b) c = add a (add b c) :=
  rec c motive (k : Nat) => add (add a b) k = add a (add b k) with
  | zero => rfl
  | succ k ih => rfl
  end

theorem congr_succ (a b : Nat) (h : a = b) : Nat.succ a = Nat.succ b := rfl

def twice (n : Nat) : Nat :=
  let result : Nat := add n n;
  result

theorem twice_zero : twice Nat.zero = Nat.zero := rfl

theorem add_left_comm (a b c : Nat) : add a (add b c) = add b (add a c) :=
  let ab : add a b = add b a := add_comm a b;
  let left : add (add a b) c = add a (add b c) := add_assoc a b c;
  let right : add (add b a) c = add b (add a c) := add_assoc b a c;
  rfl

theorem add_right_comm (a b c : Nat) : add (add a b) c = add (add a c) b :=
  let bc : add b c = add c b := add_comm b c;
  let left : add (add a b) c = add a (add b c) := add_assoc a b c;
  let right : add (add a c) b = add a (add c b) := add_assoc a c b;
  rfl

theorem add_shuffle (a b c d : Nat) :
    add (add a b) (add c d) = add (add a c) (add b d) :=
  let left : add (add a b) (add c d) = add a (add b (add c d)) :=
    add_assoc a b (add c d);
  let middle : add b (add c d) = add c (add b d) := add_left_comm b c d;
  let right : add (add a c) (add b d) = add a (add c (add b d)) :=
    add_assoc a c (add b d);
  rfl

def pred (n : Nat) : Nat :=
  rec n motive (k : Nat) => Nat with
  | zero => Nat.zero
  | succ k ih => k
  end

theorem pred_zero : pred Nat.zero = Nat.zero := rfl

theorem pred_succ (n : Nat) : pred (Nat.succ n) = n := rfl

theorem succ_inj (m n : Nat) (h : Nat.succ m = Nat.succ n) : m = n :=
  let left : pred (Nat.succ m) = m := pred_succ m;
  let right : pred (Nat.succ n) = n := pred_succ n;
  rfl

def mul (m n : Nat) : Nat :=
  rec n motive (k : Nat) => Nat with
  | zero => Nat.zero
  | succ k ih => add ih m
  end

theorem mul_zero (n : Nat) : mul n Nat.zero = Nat.zero := rfl

theorem mul_succ (m n : Nat) :
    mul m (Nat.succ n) = add (mul m n) m := rfl

theorem zero_mul (n : Nat) : mul Nat.zero n = Nat.zero :=
  rec n motive (k : Nat) => mul Nat.zero k = Nat.zero with
  | zero => rfl
  | succ k ih => rfl
  end

theorem mul_one (n : Nat) : mul n (Nat.succ Nat.zero) = n :=
  zero_add n

theorem one_mul (n : Nat) : mul (Nat.succ Nat.zero) n = n :=
  rec n motive (k : Nat) => mul (Nat.succ Nat.zero) k = k with
  | zero => rfl
  | succ k ih => rfl
  end

theorem mul_add (m n k : Nat) :
    mul m (add n k) = add (mul m n) (mul m k) :=
  rec k motive (j : Nat) => mul m (add n j) = add (mul m n) (mul m j) with
  | zero => rfl
  | succ j ih =>
    let input : add n (Nat.succ j) = Nat.succ (add n j) := add_succ n j;
    let left : mul m (Nat.succ (add n j)) = add (mul m (add n j)) m :=
      mul_succ m (add n j);
    let right : mul m (Nat.succ j) = add (mul m j) m := mul_succ m j;
    add_assoc (mul m n) (mul m j) m
  end

theorem add_mul (m n k : Nat) :
    mul (add m n) k = add (mul m k) (mul n k) :=
  rec k motive (j : Nat) => mul (add m n) j = add (mul m j) (mul n j) with
  | zero => rfl
  | succ j ih =>
    let left : mul (add m n) (Nat.succ j) = add (mul (add m n) j) (add m n) :=
      mul_succ (add m n) j;
    let first : mul m (Nat.succ j) = add (mul m j) m := mul_succ m j;
    let second : mul n (Nat.succ j) = add (mul n j) n := mul_succ n j;
    add_shuffle (mul m j) (mul n j) m n
  end

theorem succ_mul (m n : Nat) :
    mul (Nat.succ m) n = add (mul m n) n :=
  let distribute : mul (add m (Nat.succ Nat.zero)) n =
      add (mul m n) (mul (Nat.succ Nat.zero) n) :=
    add_mul m (Nat.succ Nat.zero) n;
  let one : mul (Nat.succ Nat.zero) n = n := one_mul n;
  rfl

theorem mul_comm (m n : Nat) : mul m n = mul n m :=
  rec n motive (k : Nat) => mul m k = mul k m with
  | zero => zero_mul m
  | succ k ih => succ_mul k m
  end

theorem mul_assoc (a b c : Nat) : mul (mul a b) c = mul a (mul b c) :=
  rec c motive (k : Nat) => mul (mul a b) k = mul a (mul b k) with
  | zero => rfl
  | succ k ih =>
    let left : mul (mul a b) (Nat.succ k) = add (mul (mul a b) k) (mul a b) :=
      mul_succ (mul a b) k;
    let inner : mul b (Nat.succ k) = add (mul b k) b := mul_succ b k;
    mul_add a (mul b k) b
  end

theorem mul_left_comm (a b c : Nat) : mul a (mul b c) = mul b (mul a c) :=
  let ab : mul a b = mul b a := mul_comm a b;
  let left : mul (mul a b) c = mul a (mul b c) := mul_assoc a b c;
  let right : mul (mul b a) c = mul b (mul a c) := mul_assoc b a c;
  rfl

theorem twice_mul (n : Nat) : twice n = mul n (Nat.succ (Nat.succ Nat.zero)) :=
  let one : mul n (Nat.succ Nat.zero) = n := mul_one n;
  rfl
