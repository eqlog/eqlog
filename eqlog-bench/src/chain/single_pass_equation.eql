type Key;

model World {
    type El;
    func item(Key) -> El;
    pred marked(El);
}

pred job(World, Key, Key, Key, Key);

rule propagate {
    if job(w, input, output, left, right);
    if w.item(input) = x;
    if w.marked(x);
    if w.item(output) = y;
    if w.item(left) = a;
    if w.item(right) = b;
    then w.marked(y);
    then a = b;
}
