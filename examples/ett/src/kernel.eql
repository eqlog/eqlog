type Data;
type Constructor;
type Constructors;
func data_constructors(Data) -> Constructors;
func no_data_constructors() -> Constructors;
func more_data_constructors(Constructor, Constructors) -> Constructors;
pred nullary(Constructor, Data);
pred recursive(Constructor, Data);

model Context {
    type Ty;
    type Tm;
    pred is_type(Ty);
    pred has_type(Tm, Ty);
    func type_of(Tm) -> Ty;
    func data_type(Data) -> Ty;
    func identity(Ty, Tm, Tm) -> Ty;
    func constant(Constructor) -> Tm;
    func construct(Constructor, Tm) -> Tm;
    func refl(Ty) -> Tm;

    rule inferred_type {
        if has_type(t, a);
        then type_of(t) = a;
    }
    rule data_formation {
        if a = data_type(d);
        if data_constructors(d)!;
        then is_type(a);
    }
    rule identity_formation {
        if a = identity(t, x, y);
        if has_type(x, t);
        if has_type(y, t);
        then is_type(a);
    }
    rule constant_typing {
        if t = constant(c);
        if nullary(c, d);
        if a = data_type(d);
        then has_type(t, a);
    }
    rule constructor_typing {
        if t = construct(c, x);
        if recursive(c, d);
        if a = data_type(d);
        if has_type(x, a);
        then has_type(t, a);
    }
    rule refl_typing {
        if a = identity(t, x, x);
        if is_type(a);
        if r = refl(a);
        then has_type(r, a);
        then t = t;
    }
    rule equality_reflection {
        if a = identity(t, x, y);
        if has_type(r, a);
        then x = y;
        then t = t;
        then r = r;
    }
    rule identity_uniqueness {
        if a = identity(t, x, y);
        if has_type(r, a);
        if has_type(s, a);
        then r = s;
        then t = t;
        then x = x;
        then y = y;
    }
}

func empty() -> Context;
pred valid(Context);
pred substitution(Mor(Context));
pred extension(e: Context, g: Context, a: g.Ty);
pred advance(g: Context, e: Context, p: Mor(Context));
func projection(Context) -> Mor(Context);
func variable(g: Context) -> g.Tm;
func identity_sub(Context) -> Mor(Context);
func compose(Mor(Context), Mor(Context)) -> Mor(Context);
func pair(e: Context, d: Context, f: Mor(Context), t: d.Tm) -> Mor(Context);

rule empty_context {
    if g = empty();
    then valid(g);
}
rule comprehension {
    if extension(e, g, a);
    if valid(g);
    if g.is_type(a);
    then valid(e);
    then p := projection(e)!;
    then dom(p) = g;
    then cod(p) = e;
    then substitution(p);
    then b := p.Ty(a)!;
    then q := variable(e)!;
    then e.has_type(q, b);
}
rule statement_context {
    if advance(g, e, p);
    if valid(g);
    then valid(e);
    then dom(p) = g;
    then cod(p) = e;
    then substitution(p);
}
rule identity_substitution {
    if f = identity_sub(g);
    if valid(g);
    then f = id(g);
    then substitution(f);
}
rule composition {
    if h = compose(f, g);
    if substitution(f);
    if substitution(g);
    if cod(f) = dom(g);
    then h = f >> g;
    then substitution(h);
}
rule pairing {
    if h = pair(e, d, f, t);
    if extension(e, g, a);
    if substitution(f);
    if dom(f) = g;
    if cod(f) = d;
    if b = f.Ty(a);
    if d.has_type(t, b);
    if p = projection(e);
    if q = variable(e);
    then dom(h) = e;
    then cod(h) = d;
    then substitution(h);
    then h.Tm(q) = t;
    then p >> h = f;
}
rule pairing_eta {
    if extension(e, g, a);
    if substitution(h);
    if dom(h) = e;
    if d = cod(h);
    if p = projection(e);
    if q = variable(e);
    if t = h.Tm(q);
    if f = p >> h;
    if k = pair(e, d, f, t);
    then h = k;
    then g = g;
    then a = a;
}

// Requests do not publish native images until their substitution is checked.
pred type_image(f: Mor(Context), g: Context, a: g.Ty, d: Context, b: d.Ty);
pred term_image(f: Mor(Context), g: Context, t: g.Tm, d: Context, u: d.Tm);
rule requested_type_image {
    if type_image(f, g, a, d, b);
    if substitution(f);
    if dom(f) = g;
    if cod(f) = d;
    then f.Ty(a) = b;
}
rule requested_term_image {
    if term_image(f, g, t, d, u);
    if substitution(f);
    if dom(f) = g;
    if cod(f) = d;
    then f.Tm(t) = u;
}

type Definition;
pred definition_goal(d: Definition, g: Context, t: g.Tm, a: g.Ty, exported: g.Tm);
pred checked_definition(Definition);
rule check_definition {
    if definition_goal(d, g, t, a, exported);
    if valid(g);
    if g.is_type(a);
    if g.has_type(t, a);
    then checked_definition(d);
    then exported = t;
}

type Eliminator;
type Branch;
func case_branch(Eliminator, Constructor) -> Branch;
pred branch_goal(b: Branch, g: Context, t: g.Tm, a: g.Ty);
pred checked_branch(Branch);
pred checked_cases(Eliminator, Constructors);
pred elimination(e: Eliminator, d: Data, g: Context, a: g.Ty, t: g.Tm);
rule branch_check {
    if branch_goal(b, g, t, a);
    if valid(g);
    if g.is_type(a);
    if g.has_type(t, a);
    then checked_branch(b);
}
rule no_cases {
    if e: Eliminator;
    if cs = no_data_constructors();
    then checked_cases(e, cs);
}
rule more_cases {
    if cs = more_data_constructors(c, rest);
    if b = case_branch(e, c);
    if checked_branch(b);
    if checked_cases(e, rest);
    then checked_cases(e, cs);
}
rule dependent_elimination {
    if elimination(e, d, g, a, t);
    if cs = data_constructors(d);
    if checked_cases(e, cs);
    if valid(g);
    if g.is_type(a);
    then g.has_type(t, a);
}

rule image_data_type {
    if substitution(f);
    if s = dom(f);
    if t = cod(f);
    if a = s.data_type(d);
    if b = t.data_type(d);
    then f.Ty(a) = b;
}
rule image_constant {
    if substitution(f);
    if s = dom(f);
    if t = cod(f);
    if a = s.constant(c);
    if b = t.constant(c);
    then f.Tm(a) = b;
}
rule image_constructor {
    if substitution(f);
    if s = dom(f);
    if t = cod(f);
    if a = s.construct(c, x);
    if y = f.Tm(x);
    if b = t.construct(c, y);
    then f.Tm(a) = b;
}
rule image_identity {
    if substitution(f);
    if s = dom(f);
    if t = cod(f);
    if a = s.identity(ty, x, y);
    if ty_1 = f.Ty(ty);
    if x_1 = f.Tm(x);
    if y_1 = f.Tm(y);
    if b = t.identity(ty_1, x_1, y_1);
    then f.Ty(a) = b;
}
rule image_refl {
    if substitution(f);
    if s = dom(f);
    if t = cod(f);
    if a = s.refl(ty);
    if ty_1 = f.Ty(ty);
    if b = t.refl(ty_1);
    then f.Tm(a) = b;
}

func elimination_base(Eliminator) -> Context;
pred nullary_case(e: Eliminator, c: Constructor, g: Context, k: Context, body: k.Tm);
pred recursive_case(e: Eliminator, c: Constructor, h: Context, k: Context, body: k.Tm);
pred checked_eliminator(Eliminator);
rule elimination_checked {
    if elimination(e, d, g, a, t);
    if g.has_type(t, a);
    then checked_eliminator(e);
    then d = d;
}

func application(e: Eliminator, f: Mor(Context), g: Context, x: g.Tm) -> g.Tm;
rule application_pair {
    if application(e, f, g, x)!;
    if elimination(e, d, m, a, r);
    if b = elimination_base(e);
    if substitution(f);
    if dom(f) = b;
    if cod(f) = g;
    then pair(m, g, f, x)!;
    then d = d;
    then a = a;
    then r = r;
}
rule application_image {
    if result = application(e, f, g, x);
    if elimination(e, d, m, a, r);
    if p = pair(m, g, f, x);
    if substitution(p);
    if dom(p) = m;
    if cod(p) = g;
    then p.Ty(a)!;
    then p.Tm(r) = result;
    then d = d;
}
rule image_application {
    if substitution(f);
    if s = dom(f);
    if t = cod(f);
    if a = application(e, g, s, x);
    if y = f.Tm(x);
    if h = compose(g, f);
    if b = application(e, h, t, y);
    then f.Tm(a) = b;
}

rule open_application {
    if substitution(f);
    if s = dom(f);
    if t = cod(f);
    if a = application(e, g, s, x);
    if b = f.Tm(a);
    if y = f.Tm(x);
    if h = compose(g, f);
    then application(e, h, t, y) = b;
}

func rebase(e: Context, d: Context, f: Mor(Context)) -> Mor(Context);
rule rebase_statement {
    if h = rebase(e, d, f);
    if advance(g, e, p);
    if substitution(f);
    if dom(f) = g;
    if cod(f) = d;
    then dom(h) = e;
    then cod(h) = d;
    then substitution(h);
    then p >> h = f;
}

type Expansion;
func next_expansion(Expansion) -> Expansion;
pred expand(site: Expansion, e: Eliminator, f: Mor(Context), g: Context, x: g.Tm);
pred literal(site: Expansion, g: Context, t: g.Tm);
rule literal_application {
    if literal(site, g, t);
    if t = application(e, f, g, x);
    then expand(site, e, f, g, x);
}

func through(start: Context, end: Context, target: Context, f: Mor(Context)) -> Mor(Context);
pred stage_step(Context, Context, Context);
rule through_identity {
    if h = through(g, g, d, f);
    if substitution(f);
    if dom(f) = g;
    if cod(f) = d;
    then h = f;
}
rule through_statement {
    if h = through(start, end, d, f);
    if stage_step(start, end, previous);
    then k := through(start, previous, d, f)!;
    then h = rebase(end, d, k);
}
rule beta_nullary {
    if expand(site, e, f, g, x);
    if next_expansion(site)!;
    if x = g.constant(c);
    if checked_eliminator(e);
    if nullary_case(e, c, b, k, body);
    if substitution(f);
    if dom(f) = b;
    if cod(f) = g;
    if result = application(e, f, g, x);
    then h := through(b, k, g, f)!;
    then h = h;
    then result = result;
    then body = body;
}
rule beta_nullary_result {
    if expand(site, e, f, g, x);
    if next_expansion(site)!;
    if x = g.constant(c);
    if checked_eliminator(e);
    if nullary_case(e, c, b, k, body);
    if h = through(b, k, g, f);
    if substitution(h);
    if dom(h) = k;
    if cod(h) = g;
    if result = application(e, f, g, x);
    then rhs := h.Tm(body)!;
    then result = rhs;
}
rule beta_recursive_request {
    if expand(site, e, f, g, x);
    if next_expansion(site)!;
    if x = g.construct(c, k);
    if checked_eliminator(e);
    if recursive_case(e, c, h, end, body);
    if elimination(e, d, m, a, r);
    if result = application(e, f, g, x);
    then previous := application(e, f, g, k)!;
    then p := pair(m, g, f, k)!;
    then pair(h, g, p, previous)!;
    then body = body;
    then d = d;
    then a = a;
    then r = r;
    then result = result;
    then end = end;
}
rule beta_recursive {
    if expand(site, e, f, g, x);
    if next = next_expansion(site);
    if x = g.construct(c, k);
    if checked_eliminator(e);
    if recursive_case(e, c, h, end, body);
    if elimination(e, d, m, a, r);
    if previous = application(e, f, g, k);
    if p = pair(m, g, f, k);
    if q = pair(h, g, p, previous);
    if substitution(q);
    if dom(q) = h;
    if cod(q) = g;
    if result = application(e, f, g, x);
    then through(h, end, g, q)!;
    then expand(next, e, f, g, k);
    then d = d;
    then a = a;
    then r = r;
    then body = body;
    then result = result;
}
rule beta_recursive_result {
    if expand(site, e, f, g, x);
    if next_expansion(site)!;
    if x = g.construct(c, k);
    if checked_eliminator(e);
    if recursive_case(e, c, h, end, body);
    if elimination(e, d, m, a, r);
    if previous = application(e, f, g, k);
    if p = pair(m, g, f, k);
    if q = pair(h, g, p, previous);
    if v = through(h, end, g, q);
    if substitution(v);
    if dom(v) = end;
    if cod(v) = g;
    if result = application(e, f, g, x);
    then rhs := v.Tm(body)!;
    then result = rhs;
    then d = d;
    then a = a;
    then r = r;
}
