use crate::ast::*;
use crate::grammar_util::{Location, NeverType};

grammar;

extern {
    type Error = NeverType;
}

Id: String = {
    <s : r"[A-Za-z][A-Za-z0-9'_]*"> => s.to_string(),
}

PairFirst<First, Second>: First = {
    <first: First> <second: Second> => first,
}

NonEmptyIntersperse<Item, Separator>: Vec<Item> = {
    <mut init: PairFirst<Item, Separator>*> <last: Item> => {
        init.push(last);
        init
    },
}

Intersperse<Item, Separator>: Vec<Item> = {
    <non_empty: NonEmptyIntersperse<Item, Separator>> => non_empty,
    () => vec![],
}

Variable: Term = {
    <l: @L> <name: Id> <r: @R> => Term {
        loc: Location(l, r),
        kind: TermKind::Var(name),
    },
}

Wildcard: Term = {
    <l: @L> "_" <r: @R> => Term {
        loc: Location(l, r),
        kind: TermKind::Wildcard,
    },
}

ApplicationTerm: Term = {
    <l: @L> <func: FuncExpr> <args: ArgList> <r: @R> => Term {
        loc: Location(l, r),
        kind: TermKind::App { func, args },
    },
}

DomTerm: Term = {
    <l: @L> "dom" "(" <arg: Term> ")" <r: @R> => Term {
        loc: Location(l, r),
        kind: TermKind::Dom(Box::new(arg)),
    },
}

CodTerm: Term = {
    <l: @L> "cod" "(" <arg: Term> ")" <r: @R> => Term {
        loc: Location(l, r),
        kind: TermKind::Cod(Box::new(arg)),
    },
}

MorAppTerm: Term = {
    <l: @L> <mor: Term> "@" "(" <arg: Term> ")" <r: @R> => Term {
        loc: Location(l, r),
        kind: TermKind::MorApp { mor: Box::new(mor), arg: Box::new(arg) },
    },
}

Term: Term = {
    <var: Variable> => var,
    <wildcard: Wildcard> => wildcard,
    <application: ApplicationTerm> => application,
    <dom_term: DomTerm> => dom_term,
    <cod_term: CodTerm> => cod_term,
    <app_term: MorAppTerm> => app_term,
}

TypeExpr: TypeExpr = {
    <l: @L> <name: Id> <r: @R> => TypeExpr {
        loc: Location(l, r),
        kind: TypeExprKind::Ambient(name),
    },
    <l: @L> <tm: Term> "." <name: Id> <r: @R> => TypeExpr {
        loc: Location(l, r),
        kind: TypeExprKind::Member { term: Box::new(tm), name },
    },
    <l: @L> "Mor" "(" <name: Id> ")" <r: @R> => TypeExpr {
        loc: Location(l, r),
        kind: TypeExprKind::Mor(name),
    },
}

#[inline]
PredExpr: PredExpr = {
    <l: @L> <name: Id> <r: @R> => PredExpr {
        loc: Location(l, r),
        kind: PredExprKind::Ambient(name),
    },
    <l: @L> <tm: Term> "." <name: Id> <r: @R> => PredExpr {
        loc: Location(l, r),
        kind: PredExprKind::Member { term: Box::new(tm), name },
    },
}

#[inline]
FuncExpr: FuncExpr = {
    <l: @L> <name: Id> <r: @R> => FuncExpr {
        loc: Location(l, r),
        kind: FuncExprKind::Ambient(name),
    },
    <l: @L> <tm: Term> "." <name: Id> <r: @R> => FuncExpr {
        loc: Location(l, r),
        kind: FuncExprKind::Member { term: Box::new(tm), name },
    },
}

ArgList: TermList = {
    <l: @L> "(" <args: Intersperse<Term, ",">> ")" <r: @R> => TermList {
        loc: Location(l, r),
        terms: args,
    },
}

IfAtom: IfAtom = {
    <l: @L> <lhs: Term> "=" <rhs: Term> <r: @R> => IfAtom {
        loc: Location(l, r),
        kind: IfAtomKind::Equal(lhs, rhs),
    },
    <l: @L> <tm: Term> "!" <r: @R> => IfAtom {
        loc: Location(l, r),
        kind: IfAtomKind::Defined(tm),
    },
    <l: @L> <pred: PredExpr> <args: ArgList> <r: @R> => IfAtom {
        loc: Location(l, r),
        kind: IfAtomKind::Pred { pred, args },
    },
    <l: @L> <term: Term> ":" <typ: TypeExpr> <r: @R> => IfAtom {
        loc: Location(l, r),
        kind: IfAtomKind::Var { term, typ },
    },
}

ThenAtom: ThenAtom = {
    <l: @L> <lhs: Term> "=" <rhs: Term> <r: @R> => ThenAtom {
        loc: Location(l, r),
        kind: ThenAtomKind::Equal(lhs, rhs),
    },
    <l: @L> <var: PairFirst<Term, ":=">?> <term: Term> "!" <r: @R> => ThenAtom {
        loc: Location(l, r),
        kind: ThenAtomKind::Defined { var, term },
    },
    <l: @L> <pred: PredExpr> <args: ArgList> <r: @R> => ThenAtom {
        loc: Location(l, r),
        kind: ThenAtomKind::Pred { pred, args },
    },
}

StmtBlock: Vec<Stmt> = {
    "{" <stmts: Stmt*> "}" => stmts,
}

MatchCase: MatchCase = {
    <l: @L> <pattern: Term> "=>" <body: StmtBlock> <r: @R> => MatchCase {
        loc: Location(l, r),
        pattern,
        body,
    },
}

Stmt: Stmt = {
    <l: @L> "branch" <blocks: NonEmptyIntersperse<StmtBlock, "along">> <r: @R> => Stmt {
        loc: Location(l, r),
        kind: StmtKind::Branch(blocks),
    },
    <l: @L> "if" <atom: IfAtom> ";" <r: @R> => Stmt {
        loc: Location(l, r),
        kind: StmtKind::If(atom),
    },
    <l: @L> "then" <atom: ThenAtom> ";" <r: @R> => Stmt {
        loc: Location(l, r),
        kind: StmtKind::Then(atom),
    },
    <l: @L> "match" <tm: Term> "{" <cases: MatchCase*> "}" <r: @R> => Stmt {
        loc: Location(l, r),
        kind: StmtKind::Match { term: tm, cases },
    },
}

RuleDecl: RuleDecl = {
    <l: @L> "rule" <name: Id?> "{" <body: Stmt*> "}" <r: @R> => RuleDecl {
        loc: Location(l, r),
        name,
        body,
    },
}

TypeDecl: TypeDecl = {
    <l: @L> "type" <name: Id> ";" <r: @R> => TypeDecl {
        loc: Location(l, r),
        name,
    },
}

ArgDecl: ArgDecl = {
    <l: @L> <name: PairFirst<Id, ":">?> <typ: TypeExpr> <r: @R> => ArgDecl {
        loc: Location(l, r),
        name,
        typ,
    },
}

ArgDeclList: ArgDeclList = {
    <l: @L> "(" <args: Intersperse<ArgDecl, ",">> ")" <r: @R> => ArgDeclList {
        loc: Location(l, r),
        args,
    },
}

PredDecl: PredDecl = {
    <l: @L> "pred" <name: Id> <args: ArgDeclList> ";" <r: @R> => PredDecl {
        loc: Location(l, r),
        name,
        args,
    },
}

FuncDecl: FuncDecl = {
    <l: @L> "func" <name: Id> <args: ArgDeclList> "->" <result: TypeExpr> ";" <r: @R> => FuncDecl {
        loc: Location(l, r),
        name,
        args,
        result,
    },
}

CtorDecl: CtorDecl = {
    <l: @L> <name: Id> <args: ArgDeclList> <r: @R> => CtorDecl {
        loc: Location(l, r),
        name,
        args,
    },
}

EnumDecl: EnumDecl = {
    // TODO: Let's also allow an optional comma after the last constructor. As of this writing,
    // adding a ","? there causes a shift-reduce conflict.
    <l: @L> "enum" <name: Id> "{" <ctors: Intersperse<CtorDecl, ",">> "}" <r: @R> => EnumDecl {
        loc: Location(l, r),
        name,
        ctors,
    },
}

ModelDecl: ModelDecl = {
    <l: @L> "model" <name: Id> "{" <body: Decl*> "}" <r: @R> => ModelDecl {
        loc: Location(l, r),
        name,
        body,
    },
}

Decl: Decl = {
    <t: TypeDecl> => Decl::Type(t),
    <p: PredDecl> => Decl::Pred(p),
    <f: FuncDecl> => Decl::Func(f),
    <r: RuleDecl> => Decl::Rule(r),
    <e: EnumDecl> => Decl::Enum(e),
    <m: ModelDecl> => Decl::Model(m),
}

pub Module: Module = {
    <l: @L> <decls: Decl*> <r: @R> => Module {
        loc: Location(l, r),
        decls,
    },
}
