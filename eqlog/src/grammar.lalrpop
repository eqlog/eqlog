use crate::ast::*;
use crate::grammar_util::{Location, NeverType};

grammar(ast: &mut Ast);

extern {
    type Error = NeverType;
}

Id: String = {
    <s : r"[A-Za-z][A-Za-z0-9'_]*"> => s.to_string(),
}

PairFirst<First, Second>: First = {
    <first: First> <second: Second> => first,
}

NonEmptyIntersperse<Item, Separator>: Vec<Item> = {
    <mut init: PairFirst<Item, Separator>*> <last: Item> => {
        init.push(last);
        init
    },
}

Intersperse<Item, Separator>: Vec<Item> = {
    <non_empty: NonEmptyIntersperse<Item, Separator>> => non_empty,
    () => vec![],
}

Variable: TermId = {
    <l: @L> <name: Id> <r: @R> => ast.push_term(Location(l, r), TermData::Var(name)),
}

Wildcard: TermId = {
    <l: @L> "_" <r: @R> => ast.push_term(Location(l, r), TermData::Wildcard),
}

ApplicationTerm: TermId = {
    <l: @L> <func: FuncExpr> <args: ArgList> <r: @R> =>
        ast.push_term(Location(l, r), TermData::App { func, args }),
}

DomTerm: TermId = {
    <l: @L> "dom" "(" <arg: Term> ")" <r: @R> =>
        ast.push_term(Location(l, r), TermData::Dom(arg)),
}

CodTerm: TermId = {
    <l: @L> "cod" "(" <arg: Term> ")" <r: @R> =>
        ast.push_term(Location(l, r), TermData::Cod(arg)),
}

MorAppTerm: TermId = {
    <l: @L> <mor: Term> "@" "(" <arg: Term> ")" <r: @R> =>
        ast.push_term(Location(l, r), TermData::MorApp { mor, arg }),
}

Term: TermId = {
    <var: Variable> => var,
    <wildcard: Wildcard> => wildcard,
    <application: ApplicationTerm> => application,
    <dom_term: DomTerm> => dom_term,
    <cod_term: CodTerm> => cod_term,
    <app_term: MorAppTerm> => app_term,
}

TypeExpr: TypeExprId = {
    <l: @L> <name: Id> <r: @R> =>
        ast.push_type_expr(Location(l, r), TypeExprData::Ambient(name)),
    <l: @L> <tm: Term> "." <name: Id> <r: @R> =>
        ast.push_type_expr(Location(l, r), TypeExprData::Member { term: tm, name }),
    <l: @L> "Mor" "(" <name: Id> ")" <r: @R> =>
        ast.push_type_expr(Location(l, r), TypeExprData::Mor(name)),
}

#[inline]
PredExpr: PredExprId = {
    <l: @L> <name: Id> <r: @R> =>
        ast.push_pred_expr(Location(l, r), PredExprData::Ambient(name)),
    <l: @L> <tm: Term> "." <name: Id> <r: @R> =>
        ast.push_pred_expr(Location(l, r), PredExprData::Member { term: tm, name }),
}

#[inline]
FuncExpr: FuncExprId = {
    <l: @L> <name: Id> <r: @R> =>
        ast.push_func_expr(Location(l, r), FuncExprData::Ambient(name)),
    <l: @L> <tm: Term> "." <name: Id> <r: @R> =>
        ast.push_func_expr(Location(l, r), FuncExprData::Member { term: tm, name }),
}

ArgList: TermListId = {
    <l: @L> "(" <args: Intersperse<Term, ",">> ")" <r: @R> =>
        ast.push_term_list(Location(l, r), TermListData { terms: args }),
}

IfAtom: IfAtomId = {
    <l: @L> <lhs: Term> "=" <rhs: Term> <r: @R> =>
        ast.push_if_atom(Location(l, r), IfAtomData::Equal(lhs, rhs)),
    <l: @L> <tm: Term> "!" <r: @R> =>
        ast.push_if_atom(Location(l, r), IfAtomData::Defined(tm)),
    <l: @L> <pred: PredExpr> <args: ArgList> <r: @R> =>
        ast.push_if_atom(Location(l, r), IfAtomData::Pred { pred, args }),
    <l: @L> <term: Term> ":" <typ: TypeExpr> <r: @R> =>
        ast.push_if_atom(Location(l, r), IfAtomData::Var { term, typ }),
}

ThenAtom: ThenAtomId = {
    <l: @L> <lhs: Term> "=" <rhs: Term> <r: @R> =>
        ast.push_then_atom(Location(l, r), ThenAtomData::Equal(lhs, rhs)),
    <l: @L> <var: PairFirst<Term, ":=">?> <term: Term> "!" <r: @R> =>
        ast.push_then_atom(Location(l, r), ThenAtomData::Defined { var, term }),
    <l: @L> <pred: PredExpr> <args: ArgList> <r: @R> =>
        ast.push_then_atom(Location(l, r), ThenAtomData::Pred { pred, args }),
}

StmtBlock: Vec<StmtId> = {
    "{" <stmts: Stmt*> "}" => stmts,
}

MatchCase: MatchCaseId = {
    <l: @L> <pattern: Term> "=>" <body: StmtBlock> <r: @R> =>
        ast.push_match_case(Location(l, r), MatchCaseData { pattern, body }),
}

Stmt: StmtId = {
    <l: @L> "branch" <blocks: NonEmptyIntersperse<StmtBlock, "along">> <r: @R> =>
        ast.push_stmt(Location(l, r), StmtData::Branch(blocks)),
    <l: @L> "if" <atom: IfAtom> ";" <r: @R> =>
        ast.push_stmt(Location(l, r), StmtData::If(atom)),
    <l: @L> "then" <atom: ThenAtom> ";" <r: @R> =>
        ast.push_stmt(Location(l, r), StmtData::Then(atom)),
    <l: @L> "match" <tm: Term> "{" <cases: MatchCase*> "}" <r: @R> =>
        ast.push_stmt(Location(l, r), StmtData::Match { term: tm, cases }),
}

RuleDecl: RuleDeclId = {
    <l: @L> "rule" <name: Id?> "{" <body: Stmt*> "}" <r: @R> =>
        ast.push_rule_decl(Location(l, r), RuleDeclData { name, body }),
}

TypeDecl: TypeDeclId = {
    <l: @L> "type" <name: Id> ";" <r: @R> =>
        ast.push_type_decl(Location(l, r), TypeDeclData { name }),
}

ArgDecl: ArgDeclId = {
    <l: @L> <name: PairFirst<Id, ":">?> <typ: TypeExpr> <r: @R> =>
        ast.push_arg_decl(Location(l, r), ArgDeclData { name, typ }),
}

ArgDeclList: ArgDeclListId = {
    <l: @L> "(" <args: Intersperse<ArgDecl, ",">> ")" <r: @R> =>
        ast.push_arg_decl_list(Location(l, r), ArgDeclListData { args }),
}

PredDecl: PredDeclId = {
    <l: @L> "pred" <name: Id> <args: ArgDeclList> ";" <r: @R> =>
        ast.push_pred_decl(Location(l, r), PredDeclData { name, args }),
}

FuncDecl: FuncDeclId = {
    <l: @L> "func" <name: Id> <args: ArgDeclList> "->" <result: TypeExpr> ";" <r: @R> =>
        ast.push_func_decl(Location(l, r), FuncDeclData { name, args, result }),
}

CtorDecl: CtorDeclId = {
    <l: @L> <name: Id> <args: ArgDeclList> <r: @R> =>
        ast.push_ctor_decl(Location(l, r), CtorDeclData { name, args }),
}

EnumDecl: EnumDeclId = {
    // TODO: Let's also allow an optional comma after the last constructor. As of this writing,
    // adding a ","? there causes a shift-reduce conflict.
    <l: @L> "enum" <name: Id> "{" <ctors: Intersperse<CtorDecl, ",">> "}" <r: @R> =>
        ast.push_enum_decl(Location(l, r), EnumDeclData { name, ctors }),
}

ModelDecl: ModelDeclId = {
    <l: @L> "model" <name: Id> "{" <body: Decl*> "}" <r: @R> =>
        ast.push_model_decl(Location(l, r), ModelDeclData { name, body }),
}

Decl: DeclData = {
    <t: TypeDecl> => DeclData::Type(t),
    <p: PredDecl> => DeclData::Pred(p),
    <f: FuncDecl> => DeclData::Func(f),
    <r: RuleDecl> => DeclData::Rule(r),
    <e: EnumDecl> => DeclData::Enum(e),
    <m: ModelDecl> => DeclData::Model(m),
}

pub Module: ModuleId = {
    <l: @L> <decls: Decl*> <r: @R> =>
        ast.push_module(Location(l, r), ModuleData { decls }),
}
