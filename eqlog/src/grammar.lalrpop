use crate::ast::*;
use crate::error::CompileError;
use crate::grammar_util::Location;

grammar(ast: &mut Ast);

extern {
    type Error = CompileError;
}

Id: String = {
    <s : r"[A-Za-z][A-Za-z0-9'_]*"> => s.to_string(),
}

PairFirst<First, Second>: First = {
    <first: First> <second: Second> => first,
}

NonEmptyIntersperse<Item, Separator>: Vec<Item> = {
    <mut init: PairFirst<Item, Separator>*> <last: Item> => {
        init.push(last);
        init
    },
}

Intersperse<Item, Separator>: Vec<Item> = {
    <non_empty: NonEmptyIntersperse<Item, Separator>> => non_empty,
    () => vec![],
}

IdentTerm: TermId = {
    <l: @L> <name: Id> <r: @R> => {
        let loc = Location(l, r);
        let ident = ast.push_ident_term(loc, IdentTerm { name });
        ast.push_term(loc, Term::Ident(ident))
    },
}

Wildcard: TermId = {
    <l: @L> "_" <r: @R> => ast.push_term(Location(l, r), Term::Wildcard),
}

TermAtom: ParsedTerm = {
    <l: @L> <name: Id> <r: @R> => {
        let ident = ast.push_ident_term(Location(l, r), IdentTerm { name });
        ParsedTerm::Ident(ident)
    },
    <term: Wildcard> => ParsedTerm::Term(term),
    <term: DomTerm> => ParsedTerm::Term(term),
    <term: CodTerm> => ParsedTerm::Term(term),
    "(" <term: PostfixTerm> ")" => ParsedTerm::Parenthesized(Box::new(term)),
}

TermPostfix: TermPostfix = {
    "." <l: @L> <name: Id> <r: @R> => {
        let name = ast.push_ident_term(Location(l, r), IdentTerm { name });
        TermPostfix::Member(name)
    },
    <args: ArgList> => TermPostfix::Apply(args),
}

DomTerm: TermId = {
    <l: @L> "dom" "(" <arg: Term> ")" <r: @R> => {
        let loc = Location(l, r);
        let d = ast.push_dom_term(loc, DomTerm { arg });
        ast.push_term(loc, Term::Dom(d))
    },
}

CodTerm: TermId = {
    <l: @L> "cod" "(" <arg: Term> ")" <r: @R> => {
        let loc = Location(l, r);
        let c = ast.push_cod_term(loc, CodTerm { arg });
        ast.push_term(loc, Term::Cod(c))
    },
}

PostfixTerm: ParsedPostfixTerm = {
    #[precedence(level="0")]
    <l: @L> <parsed: TermAtom> => match parsed {
        ParsedTerm::Parenthesized(mut state) => {
            state.start = l;
            *state
        }
        ParsedTerm::Ident(_) | ParsedTerm::Term(_) =>
            ParsedPostfixTerm { start: l, parsed, names: Vec::new() },
    },
    #[precedence(level="1")]
    #[assoc(side="left")]
    <mut state: PostfixTerm> <postfix: TermPostfix> => {
        match postfix {
            TermPostfix::Member(name) => state.names.push(name),
            TermPostfix::Apply(args) => {
                let head = if state.names.is_empty() {
                    match state.parsed {
                        ParsedTerm::Ident(ident) => ast.push_app_head(ast.loc(ident), AppHead::Ident(ident)),
                        ParsedTerm::Term(term) => ast.push_app_head(ast.loc(term), AppHead::Term(term)),
                        ParsedTerm::Parenthesized(_) => unreachable!("parentheses are flattened"),
                    }
                } else {
                    let receiver = match state.parsed {
                        ParsedTerm::Ident(ident) => ast.push_term(ast.loc(ident), Term::Ident(ident)),
                        ParsedTerm::Term(term) => term,
                        ParsedTerm::Parenthesized(_) => unreachable!("parentheses are flattened"),
                    };
                    let member = ast.push_app_head_member(
                        Location(state.start, ast.loc(*state.names.last().unwrap()).1),
                        AppHeadMember { receiver, names: std::mem::take(&mut state.names) },
                    );
                    ast.push_app_head(ast.loc(member), AppHead::Member(member))
                };
                let loc = Location(state.start, ast.loc(args).1);
                let app = ast.push_app_term(loc, AppTerm { head, args });
                state.parsed = ParsedTerm::Term(ast.push_term(loc, Term::App(app)));
            }
        }
        state
    },
}

#[inline]
Term: TermId = {
    <state: PostfixTerm> => {
        let mut term = match state.parsed {
            ParsedTerm::Ident(ident) => ast.push_term(ast.loc(ident), Term::Ident(ident)),
            ParsedTerm::Term(term) => term,
            ParsedTerm::Parenthesized(_) => unreachable!("parentheses are flattened"),
        };
        for name in state.names {
            let loc = Location(ast.loc(term).0, ast.loc(name).1);
            let member = ast.push_term_member(loc, TermMember { term, name });
            term = ast.push_term(loc, Term::Member(member));
        }
        term
    },
}

#[inline]
NamePath: ParsedNamePath = {
    <l: @L> <mut state: PostfixTerm> <r: @R> =>? {
        if state.names.is_empty() {
            return match state.parsed {
                ParsedTerm::Ident(ident) => Ok(ParsedNamePath::Ambient(ident)),
                ParsedTerm::Term(_) | ParsedTerm::Parenthesized(_) => {
                    Err(lalrpop_util::ParseError::User {
                        error: CompileError::UnrecognizedToken {
                            location: Location(l, r),
                            expected: vec!["name or member path".to_string()],
                        },
                    })
                }
            };
        }

        let mut receiver = match state.parsed {
            ParsedTerm::Ident(ident) => ast.push_term(ast.loc(ident), Term::Ident(ident)),
            ParsedTerm::Term(term) => term,
            ParsedTerm::Parenthesized(_) => unreachable!("parentheses are flattened"),
        };
        let final_name = state.names.pop().expect("non-empty member path");
        for name in state.names {
            let loc = Location(ast.loc(receiver).0, ast.loc(name).1);
            let member = ast.push_term_member(loc, TermMember { term: receiver, name });
            receiver = ast.push_term(loc, Term::Member(member));
        }
        let member = ast.push_term_member(
            Location(ast.loc(receiver).0, ast.loc(final_name).1),
            TermMember { term: receiver, name: final_name },
        );
        Ok(ParsedNamePath::Member(member))
    },
}

TypeExpr: TypeExprId = {
    <l: @L> "Mor" "(" <name: Id> ")" <r: @R> => {
        let loc = Location(l, r);
        let m = ast.push_mor_type_expr(loc, MorTypeExpr { name });
        ast.push_type_expr(loc, TypeExpr::Mor(m))
    },
    <l: @L> <path: NamePath> <r: @R> => {
        let loc = Location(l, r);
        match path {
            ParsedNamePath::Ambient(ident) => {
                let name = ast.ident_term(ident).name.clone();
                let ambient = ast.push_ambient_type_expr(loc, AmbientTypeExpr { name });
                ast.push_type_expr(loc, TypeExpr::Ambient(ambient))
            }
            ParsedNamePath::Member(member) => ast.push_type_expr(loc, TypeExpr::Member(member)),
        }
    },
}

#[inline]
PredExpr: PredExprId = {
    <l: @L> <path: NamePath> <r: @R> => {
        let loc = Location(l, r);
        match path {
            ParsedNamePath::Ambient(ident) => {
                let name = ast.ident_term(ident).name.clone();
                let ambient = ast.push_ambient_pred_expr(loc, AmbientPredExpr { name });
                ast.push_pred_expr(loc, PredExpr::Ambient(ambient))
            }
            ParsedNamePath::Member(member) => ast.push_pred_expr(loc, PredExpr::Member(member)),
        }
    },
}

ArgList: TermListId = {
    <l: @L> "(" <args: Intersperse<Term, ",">> ")" <r: @R> =>
        ast.push_term_list(Location(l, r), TermList { terms: args }),
}

IfAtom: IfAtomId = {
    <l: @L> <lhs: Term> "=" <rhs: Term> <r: @R> => {
        let loc = Location(l, r);
        let e = ast.push_equal_atom(loc, EqualAtom { lhs, rhs });
        ast.push_if_atom(loc, IfAtom::Equal(e))
    },
    <l: @L> <tm: Term> "!" <r: @R> => {
        let loc = Location(l, r);
        let d = ast.push_defined_if_atom(loc, DefinedIfAtom { term: tm });
        ast.push_if_atom(loc, IfAtom::Defined(d))
    },
    <l: @L> <pred: PredExpr> <args: ArgList> <r: @R> => {
        let loc = Location(l, r);
        let p = ast.push_pred_atom(loc, PredAtom { pred, args });
        ast.push_if_atom(loc, IfAtom::Pred(p))
    },
    // Keep the left side as a term so invalid binders such as `f(x) : T`
    // reach the syntactic checker and get a dedicated diagnostic instead
    // of a parser error at `:`.
    <l: @L> <term: Term> ":" <typ: TypeExpr> <r: @R> => {
        let loc = Location(l, r);
        let v = ast.push_var_if_atom(loc, VarIfAtom { term, typ });
        ast.push_if_atom(loc, IfAtom::Var(v))
    },
}

ThenAtom: ThenAtomId = {
    <l: @L> <lhs: Term> "=" <rhs: Term> <r: @R> => {
        let loc = Location(l, r);
        let e = ast.push_equal_atom(loc, EqualAtom { lhs, rhs });
        ast.push_then_atom(loc, ThenAtom::Equal(e))
    },
    // Keep the optional binder as a term so `then bar() := foo()!`
    // reaches the syntactic checker and reports "expected a variable" over
    // the whole invalid binder, rather than failing at `:=`.
    <l: @L> <var: PairFirst<Term, ":=">?> <term: Term> "!" <r: @R> => {
        let loc = Location(l, r);
        let d = ast.push_defined_then_atom(loc, DefinedThenAtom { var, term });
        ast.push_then_atom(loc, ThenAtom::Defined(d))
    },
    <l: @L> <pred: PredExpr> <args: ArgList> <r: @R> => {
        let loc = Location(l, r);
        let p = ast.push_pred_atom(loc, PredAtom { pred, args });
        ast.push_then_atom(loc, ThenAtom::Pred(p))
    },
}

StmtBlock: Vec<StmtId> = {
    "{" <stmts: Stmt*> "}" => stmts,
}

MatchCase: MatchCaseId = {
    <l: @L> <pattern: Term> "=>" <body: StmtBlock> <r: @R> =>
        ast.push_match_case(Location(l, r), MatchCase { pattern, body }),
}

Stmt: StmtId = {
    <l: @L> "branch" <blocks: NonEmptyIntersperse<StmtBlock, "along">> <r: @R> => {
        let loc = Location(l, r);
        let b = ast.push_branch_stmt(loc, BranchStmt { blocks });
        ast.push_stmt(loc, Stmt::Branch(b))
    },
    <l: @L> "if" <atom: IfAtom> ";" <r: @R> => {
        let loc = Location(l, r);
        let s = ast.push_if_stmt(loc, IfStmt { atom });
        ast.push_stmt(loc, Stmt::If(s))
    },
    <l: @L> "then" <atom: ThenAtom> ";" <r: @R> => {
        let loc = Location(l, r);
        let s = ast.push_then_stmt(loc, ThenStmt { atom });
        ast.push_stmt(loc, Stmt::Then(s))
    },
    <l: @L> "match" <tm: Term> "{" <cases: MatchCase*> "}" <r: @R> => {
        let loc = Location(l, r);
        let m = ast.push_match_stmt(loc, MatchStmt { term: tm, cases });
        ast.push_stmt(loc, Stmt::Match(m))
    },
}

RuleDecl: RuleDeclId = {
    <l: @L> "rule" <name: Id?> "{" <body: Stmt*> "}" <r: @R> =>
        ast.push_rule_decl(Location(l, r), RuleDecl { name, body }),
}

TypeDecl: TypeDeclId = {
    <l: @L> "type" <name: Id> ";" <r: @R> =>
        ast.push_type_decl(Location(l, r), TypeDecl { name }),
}

ArgDecl: ArgDeclId = {
    <l: @L> <name: PairFirst<Id, ":">?> <typ: TypeExpr> <r: @R> =>
        ast.push_arg_decl(Location(l, r), ArgDecl { name, typ }),
}

ArgDeclList: ArgDeclListId = {
    <l: @L> "(" <args: Intersperse<ArgDecl, ",">> ")" <r: @R> =>
        ast.push_arg_decl_list(Location(l, r), ArgDeclList { args }),
}

PredDecl: PredDeclId = {
    <l: @L> "pred" <name: Id> <args: ArgDeclList> ";" <r: @R> =>
        ast.push_pred_decl(Location(l, r), PredDecl { name, args }),
}

FuncDecl: FuncDeclId = {
    <l: @L> "func" <name: Id> <args: ArgDeclList> "->" <result: TypeExpr> ";" <r: @R> =>
        ast.push_func_decl(Location(l, r), FuncDecl { name, args, result }),
}

ConstDecl: ConstDeclId = {
    <l: @L> "const" <name: Id> ":" <result: TypeExpr> ";" <r: @R> =>
        ast.push_const_decl(Location(l, r), ConstDecl { name, result }),
}

CtorDecl: CtorDeclId = {
    <l: @L> <name: Id> <args: ArgDeclList> <r: @R> =>
        ast.push_ctor_decl(Location(l, r), CtorDecl { name, args }),
}

EnumDecl: EnumDeclId = {
    // TODO: Let's also allow an optional comma after the last constructor. As of this writing,
    // adding a ","? there causes a shift-reduce conflict.
    <l: @L> "enum" <name: Id> "{" <ctors: Intersperse<CtorDecl, ",">> "}" <r: @R> =>
        ast.push_enum_decl(Location(l, r), EnumDecl { name, ctors }),
}

ModelDecl: ModelDeclId = {
    <l: @L> "model" <name: Id> "{" <body: Decl*> "}" <r: @R> =>
        ast.push_model_decl(Location(l, r), ModelDecl { name, body }),
}

Decl: DeclId = {
    <l: @L> <t: TypeDecl> <r: @R> => ast.push_decl(Location(l, r), Decl::Type(t)),
    <l: @L> <p: PredDecl> <r: @R> => ast.push_decl(Location(l, r), Decl::Pred(p)),
    <l: @L> <f: FuncDecl> <r: @R> => ast.push_decl(Location(l, r), Decl::Func(f)),
    <l: @L> <c: ConstDecl> <r: @R> => ast.push_decl(Location(l, r), Decl::Const(c)),
    <l: @L> <r_: RuleDecl> <r: @R> => ast.push_decl(Location(l, r), Decl::Rule(r_)),
    <l: @L> <e: EnumDecl> <r: @R> => ast.push_decl(Location(l, r), Decl::Enum(e)),
    <l: @L> <m: ModelDecl> <r: @R> => ast.push_decl(Location(l, r), Decl::Model(m)),
}

pub Module: ModuleId = {
    <l: @L> <decls: Decl*> <r: @R> =>
        ast.push_module(Location(l, r), Module { decls }),
}
